# Copy this file to .env.local and fill in your values
# .env.local is gitignored and won't be committed

# NEXT_PUBLIC_API_URL=http://localhost:3000/api
# DATABASE_URL=
# OPENAI_API_KEY=

# Development auth bypass — set to a fixed UUID to skip magic-link login.
# Every request will be treated as this user. The user is auto-created if missing.
# NEVER set this in production — the app will throw on startup if NODE_ENV=production.
# DEV_USER_ID=
