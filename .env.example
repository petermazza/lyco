# Copy this file to .env.local and fill in your values
# .env.local is gitignored and won't be committed

# DATABASE_URL=
# OPENAI_API_KEY=

# ─── Auth ───────────────────────────────────────────────────
# Secret used to sign session tokens and magic-link hashes.
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Public URL of the deployed app (no trailing slash).
# Used as the base for magic-link URLs. Must be set in production.
# Local dev: http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ─── Email (Resend) ─────────────────────────────────────────
# API key from https://resend.com/api-keys
# If unset, magic links are logged to the server console (dev only).
RESEND_API_KEY=

# Sender address for magic-link emails.
# Use your verified domain, or the Resend sandbox: onboarding@resend.dev
EMAIL_FROM=onboarding@resend.dev

# ─── Dev bypass ─────────────────────────────────────────────
# Development auth bypass — set to a fixed UUID to skip magic-link login.
# Every request will be treated as this user. The user is auto-created if missing.
# NEVER set this in production — the app will throw on startup if NODE_ENV=production.
# DEV_USER_ID=
